# theme = dark:Catppuccin Frappe,light:Catppuccin Latte
theme = Catppuccin Frappe

# Window Customization
window-height = 60
window-width = 180
window-padding-x = 10
window-padding-y = 10

background-blur = true
background-blur = macos-glass-clear
background-opacity = 0.97

# font style
font-family = FiraCode Nerd Font Mono
font-size = 14
font-thicken = true

# Mouse & Cursor Behavior
cursor-style = block
cursor-style-blink = true
mouse-hide-while-typing = true
# copy-on-select = true


# Valid values:
# official - Use the official Ghostty icon.
# blueprint, chalkboard, microchip, glass, holographic, paper, retro, xray - Official variants of the Ghostty icon hand-created by artists (no AI).
macos-icon = retro

# Quick terminal configs
keybind = global:cmd+shift+grave_accent=toggle_quick_terminal
quick-terminal-position = bottom
quick-terminal-screen = main



# Keybindings
# shell-integration-features = "adjust_selection"

# keybind = super+shift+left=adjust_selection:left
# keybind = super+shift+right=adjust_selection:right
# keybind = super+shift+up=adjust_selection:up
# keybind = super+shift+down=adjust_selection:down

keybind = cmd+shift+left=adjust_selection:beginning_of_line
keybind = cmd+shift+right=adjust_selection:end_of_line



# Keybindings defaults
# super + alt   + shift + j     write_screen_file:open,plain
# super + alt   + shift + w     close_all_windows
# super + ctrl  + shift + j     write_screen_file:copy,plain
# super + alt   + arrow_down    goto_split:down
# super + alt   + arrow_left    goto_split:left
# super + alt   + arrow_right   goto_split:right
# super + alt   + arrow_up      goto_split:up
